#!/usr/bin/env bash
set -euo pipefail

if [[ -L /etc/openiem || ( -e /etc/openiem && ! -d /etc/openiem ) ]]; then
  echo "refusing symlink or non-directory /etc/openiem" >&2
  exit 1
fi
if [[ -L /etc/openiem/keys || ( -e /etc/openiem/keys && ! -d /etc/openiem/keys ) ]]; then
  echo "refusing symlink or non-directory /etc/openiem/keys" >&2
  exit 1
fi
if [[ -L /etc/openiem/openiem-server.env || ( -e /etc/openiem/openiem-server.env && ! -f /etc/openiem/openiem-server.env ) ]]; then
  echo "refusing symlink or non-regular /etc/openiem/openiem-server.env" >&2
  exit 1
fi

if ! getent group openiem >/dev/null; then groupadd --system openiem; fi
if ! id -u openiem >/dev/null 2>&1; then useradd --system --gid openiem --home-dir /var/lib/openiem --no-create-home --shell /usr/sbin/nologin openiem; fi
install -d -o openiem -g openiem -m 0750 /var/lib/openiem
install -d -o root -g openiem -m 0750 /etc/openiem /etc/openiem/keys
if [[ ! -e /etc/openiem/openiem-server.env ]]; then install -o root -g openiem -m 0640 /usr/share/doc/openiem/openiem-server.env.example /etc/openiem/openiem-server.env; else chown root:openiem /etc/openiem/openiem-server.env; chmod 0640 /etc/openiem/openiem-server.env; fi
systemctl daemon-reload || true
if [[ "${DPKG_MAINTSCRIPT_PACKAGE:-}" == openiem ]]; then systemctl enable openiem-server.service >/dev/null 2>&1 || true; fi
exit 0
