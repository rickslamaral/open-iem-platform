[Unit]
Description=Open IEM API Server
Documentation=https://github.com/rickslamaral/open-iem-platform
After=network.target
Wants=network.target

[Service]
Type=simple
User=openiem
Group=openiem
WorkingDirectory=/var/lib/openiem
EnvironmentFile=-/etc/openiem/openiem-server.env
ExecStart=/usr/lib/openiem/api-server
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openiem
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
