# Copy to /etc/openiem/openiem-server.env. Do not put secrets in packages.
OPENIEM_BIND_ADDR=127.0.0.1:8080
OPENIEM_DB_PATH=/var/lib/openiem/openiem.db
OPENIEM_ALLOWED_ORIGINS=https://iem.local
RUST_LOG=api_server=info,tower_http=warn
# Set key paths after provisioning Ed25519 keys:
# OPENIEM_JWT_PRIVATE_PEM=/etc/openiem/keys/ed25519_private.pem
# OPENIEM_JWT_PUBLIC_PEM=/etc/openiem/keys/ed25519_public.pem
