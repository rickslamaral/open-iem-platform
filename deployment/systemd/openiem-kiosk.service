[Unit]
Description=Open IEM kiosk QR display
After=openiem-server.service openiem-qr-broker.service network-online.target
Wants=network-online.target
Requires=openiem-server.service openiem-qr-broker.service
ConditionPathExists=/usr/local/libexec/openiem-kiosk-launch
ConditionPathExists=/run/openiem-qr-broker/capability
ConditionPathExists=/run/openiem-qr-broker

# Broker owns QR generation; kiosk receives public page only.
# No administrator credential enters this unit.

[Service]
Type=simple
User=openiem-kiosk
Group=openiem-kiosk
Environment=HOME=/var/lib/openiem-kiosk
ExecStart=/usr/local/libexec/openiem-kiosk-launch
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openiem-kiosk

[Install]
WantedBy=multi-user.target
