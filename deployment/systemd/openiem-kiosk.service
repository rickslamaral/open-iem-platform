[Unit]
Description=Open IEM kiosk (disabled pending secure local QR broker)
After=openiem-server.service network-online.target
Wants=network-online.target
Requires=openiem-server.service
ConditionPathExists=/usr/local/libexec/openiem-kiosk-launch
ConditionPathExists=/run/openiem-kiosk-secure-qr-broker

[Service]
Type=simple
User=openiem-kiosk
Group=openiem-kiosk
Environment=HOME=/var/lib/openiem-kiosk
ExecStart=/usr/local/libexec/openiem-kiosk-launch
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openiem-kiosk

[Install]
WantedBy=multi-user.target
