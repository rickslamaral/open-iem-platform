[Unit]
Description=Open IEM API Server
Documentation=https://github.com/rickslamaral/open-iem-platform
After=network.target
Requires=network.target

[Service]
Type=simple
User=openiem
Group=openiem
WorkingDirectory=/opt/openiem

# Binary installed at /usr/local/bin/api-server by the release package.
ExecStart=/usr/local/bin/api-server

# Required: Ed25519 JWT keys. Generate with:
#   openssl genpkey -algorithm ed25519 -out /etc/openiem/keys/ed25519_private.pem
#   openssl pkey -in /etc/openiem/keys/ed25519_private.pem -pubout -out /etc/openiem/keys/ed25519_public.pem
#   chmod 600 /etc/openiem/keys/ed25519_private.pem
#   chown openiem:openiem /etc/openiem/keys/ed25519_private.pem
Environment=OPENIEM_JWT_PRIVATE_PEM=/etc/openiem/keys/ed25519_private.pem
Environment=OPENIEM_JWT_PUBLIC_PEM=/etc/openiem/keys/ed25519_public.pem

# SQLite database — writable by openiem user.
Environment=OPENIEM_DB_PATH=/var/lib/openiem/openiem.db
Environment=OPENIEM_MUSICIAN_WEB_ROOT=/opt/openiem/current/web/musician

# Installer changes this to 0.0.0.0:8080 only with --kiosk. Default stays loopback.
Environment=OPENIEM_BIND_ADDR=127.0.0.1:8080
# Kiosk enables explicit same-host LAN origins; disabled mode uses allowlist below.
Environment=OPENIEM_KIOSK_MODE=false
# Browser state-changing requests must match TLS reverse-proxy origin.
Environment=OPENIEM_ALLOWED_ORIGINS=https://iem.local

# Kiosk LAN mode is plain HTTP on local networks, not Internet-safe. Use a TLS
# reverse proxy and explicit HTTPS origins for untrusted networks.
# OPENIEM_ALLOW_INSECURE_HTTP is intentionally NOT set here.
# Non-loopback HTTP is rejected unless installer explicitly enables kiosk mode.

# Logging
Environment=RUST_LOG=api_server=info,tower_http=warn

# Restart policy
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openiem

# Limit file descriptors (WebSocket connections)
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
