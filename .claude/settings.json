{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt --all -- --check)",
      "Bash(cargo clippy --all-targets --all-features -- -D warnings)",
      "Bash(cargo test --workspace)",
      "Bash(cargo build*)",
      "Bash(npm run typecheck)",
      "Bash(npm test*)",
      "Bash(npm run build)",
      "Bash(python3 -m pytest*)",
      "Bash(python3 tests/*)",
      "Bash(bash scripts/validate-skills.sh)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.secret)",
      "Bash(git push --force*)"
    ]
  }
}
